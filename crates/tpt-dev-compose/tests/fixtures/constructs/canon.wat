;; Canonical functions: lift, lower, and the resource built-ins.
(component
  (core module $m
    (memory (export "memory") 1)
    (func (export "realloc") (param i32 i32 i32 i32) (result i32) i32.const 0)
    (func (export "post") (param i32))
    (func (export "f") (param i32) (result i32) local.get 0)
  )
  (core instance $i (instantiate $m))
  (alias core export $i "memory" (core memory $mem))
  (alias core export $i "f" (core func $f))
  (alias core export $i "realloc" (core func $realloc))
  (alias core export $i "post" (core func $post))
  (type $fty (func (param "a" u32) (result u32)))
  (import "h" (func $h (type $fty)))
  (func $lifted (type $fty)
    (canon lift (core func $f) string-encoding=utf16 (memory $mem) (realloc $realloc) (post-return $post)))
  (export "lifted" (func $lifted))
  (core func $lowered (canon lower (func $h) (memory $mem) (realloc $realloc) string-encoding=utf8))
  (core func (canon lower (func $lifted) string-encoding=latin1+utf16))
  (type $r (resource (rep i32)))
  (core func $new (canon resource.new $r))
  (core func (canon resource.rep $r))
  (core func (canon resource.drop $r))
)
